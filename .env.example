# ---------------------------------------------------------------------------
# PPIS Website — environment configuration (Version 2)
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# ---------------------------------------------------------------------------

# Endpoint that receives quotation / enquiry / resume submissions from the
# Get a Quote, Careers and product enquiry forms. Any service that accepts a
# JSON POST works (Formspree, Basin, Web3Forms, your own API, etc.).
#
# The forms POST JSON shaped like:
#   { fullName, company, email, phone, interest, location, requirement,
#     message, source, submittedAt }
#
# While this is empty the forms validate the input and then clearly tell the
# visitor the online service is not connected — they never fake a success.
#
# Example:
#   VITE_QUOTE_ENDPOINT=https://formspree.io/f/your-form-id
VITE_QUOTE_ENDPOINT=
